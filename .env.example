# Kopieren nach .env und mit echten Werten füllen. .env wird nie committed (siehe .gitignore).

# Pflicht für die KI-Dokumentgenerierung (Vorlagen-Seite)
ANTHROPIC_API_KEY=

# Pflicht für Passwort-Reset-E-Mails (siehe resend.com) - ohne diesen Key wird der
# Versand übersprungen (kein Absturz, aber es kommt keine Mail an)
RESEND_API_KEY=
MAIL_FROM=WARP Tool <onboarding@resend.dev>

# Optional - Absicherung des /api/inbox-Webhooks (IMPULSE-Anbindung)
WARP_INBOX_API_KEY=

# Optional - Flask-Session-Secret (sonst wird ein unsicherer Dev-Default verwendet)
SECRET_KEY=

# Optional - überschreibt die lokale SQLite-Datei mit einer Postgres-Verbindung
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
